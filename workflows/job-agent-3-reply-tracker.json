    {
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst schema={type:'object',properties:{reasoning:{type:'string'},\n category:{type:'string',enum:['accepted','interview_request','rejected','info_request','acknowledgment','auto_reply','other']},\n confidence:{type:'integer'},summary:{type:'string'},deadline:{type:'string'}},\n required:['reasoning','category','confidence','summary','deadline']};\nconst system=`You classify ONE email received after a job application. Think step by step in \"reasoning\": who is the sender (a human recruiter or an automated system), what is the explicit message, are there decision words (English, French or Arabic: \"unfortunately\", \"regret\", \"not selected\", \"malheureusement\", \"nous avons le plaisir\", \"convocation\", \"entretien\", \"interview\", \"offer\", \"offre\", \"next steps\").\nCategories:\n- accepted: a job or internship offer, or an explicit selection / acceptance.\n- interview_request: invitation to an interview, test, call or meeting, or a request to propose availability.\n- rejected: clear refusal, position filled, not selected.\n- info_request: asks the candidate for documents, answers or details, but is neither an offer nor a rejection.\n- acknowledgment: a human or system confirms reception and says they will come back, no decision.\n- auto_reply: out-of-office or no-reply autoresponder with no real content.\n- other: anything else or unclear.\nconfidence 0-100. summary: one short sentence in English. deadline: any date, time or deadline stated in the email, else an empty string. Never guess a decision that the email does not state.`;\nreturn $input.all().map(it=>{const j=it.json;\n const user=`JOB: ${j.title} at ${j.company}\\nFROM: ${j.incoming_from}\\nSUBJECT: ${j.incoming_subject}\\n\\nEMAIL:\\n${j.incoming_text}`;\n return {json:{...j,ollamaBody:{model:cfg.model,stream:false,format:schema,options:{temperature:0,num_ctx:4096},messages:[{role:'system',content:system},{role:'user',content:user}]}}};});"
      },
