    {
      "parameters": {
        "jsCode": "function parseLLM(r){let t=(r&&r.message&&r.message.content)||'';t=t.replace(/^\\s*```(?:json)?/i,'').replace(/```\\s*$/,'').trim();try{return JSON.parse(t);}catch(e){const m=t.match(/\\{[\\s\\S]*\\}/);if(m){try{return JSON.parse(m[0]);}catch(e2){}}return null;}}\nconst map={accepted:'accepted',interview_request:'interview',rejected:'rejected',info_request:'action_needed',acknowledgment:'acknowledged',other:'action_needed'};\nconst now=new Date().toISOString();\nreturn $input.all().map((it,i)=>{const {ollamaBody,incoming_text,...j}=$('Classify Prompt').itemMatching(i).json;\n const c=parseLLM(it.json);\n let cat=c&&c.category?c.category:'other';\n if(!c||Number(c.confidence)<60)cat=cat==='auto_reply'?'auto_reply':'other';\n const summary=(c&&c.summary)||'Could not classify, read the email';\n const deadline=(c&&c.deadline)?(' | '+c.deadline):'';\n const auto=cat==='auto_reply';\n return {json:{...j,category:cat,is_auto:auto,new_status:auto?j.status:map[cat],response_summary:(cat==='other'?'[unsure] ':'')+summary+deadline,classified_at:now}};});"
      },
