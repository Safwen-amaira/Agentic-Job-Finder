    {
      "parameters": {
        "jsCode": "const b64=s=>Buffer.from(String(s||'').replace(/-/g,'+').replace(/_/g,'/'),'base64').toString('utf8');\nconst walk=(p,t)=>{if(!p)return '';if(p.mimeType===t&&p.body&&p.body.data)return b64(p.body.data);for(const c of (p.parts||[])){const r=walk(c,t);if(r)return r;}return '';};\nconst hdr=(m,n)=>{const h=((m.payload&&m.payload.headers)||[]).find(x=>String(x.name).toLowerCase()===n);return h?h.value:'';};\nconst bodyOf=m=>{let t=walk(m.payload,'text/plain');\n if(!t){t=walk(m.payload,'text/html').replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&');}\n if(!t)t=m.snippet||'';\n t=t.replace(/\\r/g,'');\n const cut=t.search(/\\n\\s*(On .{5,90} wrote:|Le .{5,90} a écrit|-----Original Message-----|De ?:\\s.+\\nEnvoy)/);\n if(cut>0)t=t.slice(0,cut);\n t=t.split('\\n').filter(l=>!l.trim().startsWith('>')).join('\\n');\n return t.replace(/[ \\t]+/g,' ').replace(/\\n{3,}/g,'\\n\\n').trim().slice(0,1800);};\nreturn $input.all().map((it,i)=>{\n const r=$('Pending').itemMatching(i).json;\n const msgs=it.json.messages||[];\n if(it.json.error||!msgs.length)return {json:{...r,route:'skip'}};\n const mine=m=>(m.labelIds||[]).includes('SENT');\n const isBounce=m=>!mine(m)&&/mailer-daemon|postmaster/i.test(hdr(m,'from'));\n const incoming=msgs.filter(m=>!mine(m)&&!isBounce(m));\n const last=msgs[msgs.length-1];const li=incoming[incoming.length-1];\n const base={...r,thread_last_id:last.id,last_is_mine:mine(last)};\n if(msgs.some(isBounce))return {json:{...base,route:'bounced'}};\n if(li&&li.id!==r.last_incoming_id)return {json:{...base,route:'classify',incoming_id:li.id,incoming_from:hdr(li,'from'),incoming_subject:hdr(li,'subject'),incoming_text:bodyOf(li)}};\n return {json:{...base,route:'wait'}};});"
      },
