    {
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst now=Date.now();const dow=new Date().getDay();const weekend=dow===0||dow===6;\nconst d=Number(cfg.followUpDays),maxF=Number(cfg.maxFollowUps);\nreturn $input.all().map(it=>{const r=it.json;\n const last=Date.parse(r.last_contact_at||r.applied_at)||now;\n const days=Math.floor((now-last)/86400000);\n const wait=r.status==='acknowledged'?d*2:d;\n const n=Number(r.follow_up_count||0);\n const remember=r.incoming_id||'';\n let route='none';\n if(days>=wait){\n   if(n>=maxF)route='close';\n   else if(!(weekend&&cfg.skipWeekends))route='followup';\n   else if(remember)route='remember';\n }else if(remember)route='remember';\n return {json:{...r,days_since:days,remember_id:remember,route}};});"
      },
