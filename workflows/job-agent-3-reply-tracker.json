        "jsCode": "const rowOf=o=>{const r={};for(const k in o){const v=o[k];if(v!==undefined&&v!==null)r[k]=Array.isArray(v)?v.join(', '):v;}return r;};\nconst now=new Date().toISOString();\nreturn $input.all().map(it=>{const j=it.json;\n return {json:rowOf({job_id:j.job_id,status:j.new_status,response_summary:j.response_summary,last_incoming_id:j.incoming_id,last_contact_at:now,last_message_id:j.thread_last_id,last_checked_at:now})};});"
