    {
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst label={accepted:'ACCEPTED',interview:'INTERVIEW',rejected:'Rejected',action_needed:'ACTION NEEDED'};\nconst items=$input.all().map(i=>i.json);\nif(!items.length)return [];\nconst order=['accepted','interview','action_needed','rejected'];\nitems.sort((a,b)=>order.indexOf(a.new_status)-order.indexOf(b.new_status));\nconst lines=items.map(j=>`[${label[j.new_status]||j.new_status}] ${j.title} at ${j.company}\\n  ${j.response_summary}\\n  From: ${j.incoming_from}`);\nconst urgent=items.filter(j=>['accepted','interview','action_needed'].includes(j.new_status)).length;\nreturn [{json:{to:cfg.myEmail,subject:`Job Agent: ${items.length} new response(s)${urgent?`, ${urgent} need you`:''}`,body:lines.join('\\n\\n')+'\\n\\nThe sheet has been updated.'}}];"
      },
