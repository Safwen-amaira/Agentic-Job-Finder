    {
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst schema={type:'object',properties:{reasoning:{type:'string'},body:{type:'string'}},required:['reasoning','body']};\nconst system=`You write one short follow-up email for a job application that got no answer. Rules:\n- Same language as the original application email.\n- 50 to 90 words, polite, calm, never pushy, no guilt, no placeholders.\n- Mention the job title, say the application was sent ${'${'}days${'}'} days ago in a natural way, restate interest in one sentence, ask if there is any update or anything else needed.\n- Do NOT add any new claim about the candidate: no new skills, tools, experience or achievements. Only what the original email already says.\n- Follow-up 1: friendly check-in. Follow-up 2 (final): even shorter, say you understand if the position is already filled and that you remain interested for future openings.\n- Sign with the candidate name. Return only the email body, no subject.`;\nreturn $input.all().map(it=>{const j=it.json;const num=Number(j.follow_up_count)+1;\n const user=`CANDIDATE NAME: ${cfg.candidateName}\\nJOB TITLE: ${j.title}\\nCOMPANY: ${j.company}\\nFOLLOW-UP NUMBER: ${num} of ${cfg.maxFollowUps}\\nDAYS SINCE LAST EMAIL: ${j.days_since}\\n\\nORIGINAL APPLICATION EMAIL:\\n${(j.cover_letter||'').slice(0,2500)}`;\n return {json:{...j,ollamaBody:{model:cfg.model,stream:false,format:schema,options:{temperature:0.3,num_ctx:4096},messages:[{role:'system',content:system.replace('${days}',String(j.days_since))},{role:'user',content:user}]}}};});"
      },
