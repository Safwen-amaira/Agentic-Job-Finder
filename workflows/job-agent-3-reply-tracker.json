        "jsCode": "const ok=['applied','acknowledged'];\nreturn $input.all().filter(it=>ok.includes(String(it.json.status||'').trim())&&it.json.thread_id).map(it=>{const r=it.json;\n return {json:{job_id:r.job_id,title:r.title,company:r.company,status:String(r.status).trim(),apply_email:r.apply_email,thread_id:r.thread_id,\n  applied_at:r.applied_at,last_contact_at:r.last_contact_at,follow_up_count:Number(r.follow_up_count||0),last_incoming_id:r.last_incoming_id||'',cover_letter:r.cover_letter||''}};});"
      },
